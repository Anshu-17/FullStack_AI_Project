# =====================================================================================================
# Business Evidence Platform - backend settings TEMPLATE.
#
#   1. Copy this file:   cp .env.example .env        (Windows: copy .env.example .env)
#   2. Fill in every value marked  <FILL IN>  below. The other values are sensible defaults.
#   3. NEVER commit .env - it is git-ignored. This template contains only fake placeholder values.
#
# Minimum to run locally: DATABASE_URL, JWT_SECRET and at least ONE AI key (GOOGLE_API_KEY or GROQ_API_KEY).
# =====================================================================================================

# --- Runtime --------------------------------------------------------------------------------------
ENVIRONMENT=development                 # development | production (production refuses weak secrets / test hooks)
LOG_LEVEL=INFO
LOG_JSON=true                           # false = easier-to-read console logs
CORS_ORIGINS=http://localhost:8501      # the Streamlit UI address

# --- Database (PostgreSQL 16+) -------------------------------------------------------------------- <FILL IN>
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Create the database first:  createdb -U postgres bep
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bep

# --- Login tokens ---------------------------------------------------------------------------------- <FILL IN>
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# --- Demo accounts created by `python -m app.db.seed` ---------------------------------------------
# Choose passwords here, or leave them blank and the seed prints random ones ONCE (development only).
SEED_REVIEWER_EMAIL=reviewer@demo.local
SEED_REVIEWER_PASSWORD=
SEED_VIEWER_EMAIL=viewer@demo.local
SEED_VIEWER_PASSWORD=

# --- AI providers: google | groq | anthropic | xai | openai --------------------------------------- <FILL IN>
# A provider is used only if BOTH its *_API_KEY and *_MODEL are set; others are skipped.
# AI_PROVIDER is tried first; AI_FALLBACK_PROVIDERS (comma-separated) are tried in order after it.
# Free keys: Gemini -> https://aistudio.google.com/apikey   Groq -> https://console.groq.com/keys
AI_PROVIDER=google
AI_FALLBACK_PROVIDERS=groq
AI_TIMEOUT_SECONDS=60                   # seconds before one AI call is abandoned
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional extra providers (leave blank to skip)
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
XAI_MODEL=
XAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional prices in USD per million tokens for cost estimates. Blank = cost "unknown" (never guessed).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# --- Crawler ----------------------------------------------------------------------------------------
# Pages fetched per website (homepage + most relevant links / sitemap pages). The 5 MB total and the
# 120 s per-site deadline still apply.
CRAWL_MAX_PAGES=12
# TEST ONLY: hostnames that may resolve to private IPs (local fixture sites). IGNORED in production.
CRAWL_ALLOWED_PRIVATE_HOSTS=

# --- Worker (optional) ------------------------------------------------------------------------------
# WORKER_CONCURRENCY=2                  # jobs processed in parallel (keep low on free AI tiers)
# JOB_LEASE_SECONDS=120                 # a job not heartbeated for this long is picked up again
