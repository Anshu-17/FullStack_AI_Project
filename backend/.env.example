ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:8501
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bep
JWT_SECRET=replace-with-a-long-random-string
# CRAWL_ALLOWED_PRIVATE_HOSTS: comma-separated hostnames that may resolve to private IPs.
# ONLY for local test fixtures (e.g. fixtures.localhost). IGNORED when ENVIRONMENT=production.
CRAWL_ALLOWED_PRIVATE_HOSTS=
SEED_REVIEWER_EMAIL=reviewer@demo.local
SEED_REVIEWER_PASSWORD=
SEED_VIEWER_EMAIL=viewer@demo.local
SEED_VIEWER_PASSWORD=
# --- AI providers: google | groq | anthropic | xai | openai ---
# A provider is used only if BOTH its *_API_KEY and *_MODEL are set; others are skipped.
# AI_PROVIDER is tried first; AI_FALLBACK_PROVIDERS (comma-separated) are tried in order after it.
AI_PROVIDER=google
AI_FALLBACK_PROVIDERS=groq
# Seconds before one AI call is abandoned
AI_TIMEOUT_SECONDS=60
# Gemini (Google AI Studio key)
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
# Groq, via its OpenAI-compatible API
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
XAI_MODEL=
XAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional prices in USD per million tokens for cost estimates. Leave blank = cost "unknown" (NULL).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
