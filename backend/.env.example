ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:8501
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bep
JWT_SECRET=replace-with-a-long-random-string
# CRAWL_ALLOWED_PRIVATE_HOSTS: comma-separated hostnames that may resolve to private IPs.
# ONLY for local test fixtures (e.g. fixtures.localhost). IGNORED when ENVIRONMENT=production.
CRAWL_ALLOWED_PRIVATE_HOSTS=
SEED_REVIEWER_EMAIL=reviewer@demo.local
SEED_REVIEWER_PASSWORD=
SEED_VIEWER_EMAIL=viewer@demo.local
SEED_VIEWER_PASSWORD=
# AI_PROVIDER: anthropic | google | xai
AI_PROVIDER=anthropic
# AI_FALLBACK_PROVIDERS: comma-separated, tried in order, e.g. google,xai
AI_FALLBACK_PROVIDERS=
AI_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
